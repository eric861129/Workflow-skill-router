{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eric861129.github.io/Workflow-skill-router/schemas/v2/route-observation.schema.json",
  "title": "Workflow Skill Router Route Observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "artifact_kind",
    "observation_id",
    "observation_digest",
    "workflow_run_digest",
    "workflow_fingerprint",
    "workspace_identity_digest",
    "work_mode",
    "terminal_status",
    "required_gates_passed",
    "side_effect_outcome",
    "risk_class",
    "policy_snapshot_id",
    "route_signature_digest",
    "route_source",
    "routing_profile_ids",
    "routing_profile_digest",
    "matched_profile_rule_id",
    "matcher_seed",
    "phases",
    "target_profile_class",
    "activation_status",
    "evidence_class",
    "automatic_promotion_eligible",
    "observed_at"
  ],
  "properties": {
    "schema_id": { "const": "workflow-skill-router/route-observation" },
    "schema_version": { "const": "1.0.0" },
    "artifact_kind": { "const": "route-observation" },
    "observation_id": {
      "type": "string",
      "pattern": "^observation:[0-9a-f]{32}$"
    },
    "observation_digest": { "$ref": "#/$defs/digest" },
    "workflow_run_digest": { "$ref": "#/$defs/digest" },
    "workflow_fingerprint": { "$ref": "#/$defs/digest" },
    "workspace_identity_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "work_mode": {
      "enum": ["single", "phased", "managed-goal"]
    },
    "terminal_status": { "const": "completed" },
    "required_gates_passed": { "const": true },
    "side_effect_outcome": {
      "enum": ["none", "known-success", "known-failure", "unknown"]
    },
    "risk_class": { "enum": ["r0", "r1", "r2", "r3"] },
    "policy_snapshot_id": { "$ref": "#/$defs/digest" },
    "route_signature_digest": { "$ref": "#/$defs/digest" },
    "route_source": { "$ref": "#/$defs/identifier" },
    "routing_profile_ids": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "routing_profile_digest": {
      "oneOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "matched_profile_rule_id": {
      "oneOf": [
        { "$ref": "#/$defs/identifier" },
        { "type": "null" }
      ]
    },
    "matcher_seed": { "$ref": "#/$defs/matcherSeed" },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/phase" }
    },
    "target_profile_class": {
      "enum": [
        "managed-personal",
        "managed-workspace-local",
        "user-personal",
        "workspace-file"
      ]
    },
    "activation_status": { "const": "unverified" },
    "evidence_class": { "const": "user-or-agent-reported-local" },
    "automatic_promotion_eligible": { "type": "boolean" },
    "observed_at": {
      "type": "string",
      "format": "date-time",
      "maxLength": 40
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "matcherValue": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "matcherSeed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_keywords", "domains", "tags", "source"],
      "properties": {
        "objective_keywords": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/matcherValue" }
        },
        "domains": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/matcherValue" }
        },
        "tags": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/matcherValue" }
        },
        "source": {
          "enum": [
            "trusted-routing-context",
            "existing-profile",
            "user-explicit"
          ]
        }
      }
    },
    "skillId": {
      "type": "string",
      "pattern": "^skill:[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "primary_skill_id",
        "support_skill_ids",
        "exit_gate_ids"
      ],
      "properties": {
        "phase_id": { "$ref": "#/$defs/identifier" },
        "primary_skill_id": {
          "oneOf": [
            { "$ref": "#/$defs/skillId" },
            { "type": "null" }
          ]
        },
        "support_skill_ids": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/skillId" }
        },
        "exit_gate_ids": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  }
}
