          ["Install", "/plugin install workflow-skill-router@workflow-skill-router", "code", "Installs the Plugin with its MCP server and Skill."],
          ["Check", "Show the Workflow Skill Router status and explain which capabilities are available in this environment.", "prompt", "Expect the bundled-local-r0 runtime."],
          ["Needs", "Node.js 24+ and Python 3.11+", "text", "No npm install. State stays outside the Plugin cache."]
        ]
      },
      {
        "id": "codex",
        "label": "Codex",
        "note": "Release v2.1.1",
        "guide": "guides/install-plugin",
        "guideLabel": "Codex guide",
        "rows": [
          ["Add", "codex plugin marketplace add eric861129/Workflow-skill-router --ref v2.1.1", "code", "Pins the v2.1.1 release."],
          ["Install", "codex plugin add workflow-skill-router@workflow-skill-router", "code", "Then run codex plugin list to confirm it."],
          ["Check", "Show the Workflow Skill Router status and explain which capabilities are available in this environment.", "prompt", "Ask in a new Codex task."],
          ["Needs", "Node.js 24+ and Python 3.11+", "text", "The release already includes the MCP bundle and runtime."]
        ]
      },
      {
        "id": "skill",
        "label": "Skill only",
        "note": "Instructions without the MCP runtime",
        "guide": "guides/install-skill",
