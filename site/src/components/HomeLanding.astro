      "memory": ["Workflow Memory", "Off until you turn it on. No background learning.", "Off"],
      "runtime": ["Runtime check", "A planned Skill that is not installed is reported, never swapped.", "unavailable"],
      "hosts": ["Two hosts, one Profile", "Claude Code and Codex read the same personal Profile."],
      "usage": ["Usage report", "Planned and actual Skills, side by side when the work ends.", "planned", "used"],
      "path": ["Workspace Profile", "Claude Code reads .claude/ first, then .codex/."]
    },
    "memoryTitle": "Memory Flight Recorder",
    "installTitle": ["Two commands,", "then one question."],
    "installGuide": "Read the install guides",
    "installTabsLabel": "Install target",
    "installTabs": [
