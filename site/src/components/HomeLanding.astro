        "rows": [
          ["加入", "codex plugin marketplace add eric861129/Workflow-skill-router --ref v2.1.1", "code", "固定使用 v2.1.1 發布版本。"],
          ["安裝", "codex plugin add workflow-skill-router@workflow-skill-router", "code", "再執行 codex plugin list 確認。"],
