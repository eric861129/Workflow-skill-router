import memoryFlightRecorder from '../data/memory-flight-recorder.generated.json';
const m4bIsZh = Astro.currentLocale?.toLowerCase() === 'zh-tw';
const features = text.features;
---

<div class="wsr-landing not-content" data-wsr-home data-locale={locale}>
  <section class="wsr-hero" aria-labelledby="_top">
    <div class="wsr-name-band">
      <h1 id="_top" class="wsr-name"><a href={rootPath + '/'}>Workflow Skill Router</a></h1>
    </div>

    <nav class="wsr-hero-links" aria-label={text.navLabel}>
      {text.nav.map(([label, href]) => (
        <a class="wsr-link-tile" href={href}>{label}</a>
      ))}
      <a class="wsr-link-tile wsr-link-tile-small" href={alternateLocalePath} aria-label={localeSwitchLabel}>{alternateLocaleLabel}</a>
      <button
        class="wsr-link-tile wsr-link-tile-small wsr-theme-toggle"
        type="button"
        data-wsr-theme-toggle
        data-light-label={themeLabels.light}
        data-dark-label={themeLabels.dark}
        aria-label={themeToggleLabel}
      >
        <span data-wsr-theme-label>{themeLabels.dark}</span>
      </button>
    </nav>

    <div class="wsr-hero-left">
      <div class="wsr-library" data-ui>
        <p class="wsr-library-title">{text.libraryTitle}</p>
        <ul>
          {text.library.map(([name, state, kind], index) => (
            <li class={`is-${kind}`} style={`--i:${index}`}>
              <span class="wsr-library-name">{name}</span>
              <span class="wsr-library-state">{state}</span>
            </li>
          ))}
        </ul>
      </div>
      <ul class="wsr-facts">
        {text.facts.map((fact) => <li>{fact}</li>)}
      </ul>
    </div>

    <div class="wsr-hero-center">
      <figure class="wsr-terminal" data-ui aria-label={text.terminalLabel}>
        <pre><code><span class="t-prompt">&gt;</span> /plugin install workflow-skill-router@workflow-skill-router
<span class="t-prompt">&gt;</span> {text.terminalRequest}

<span class="t-tool">workflow-skill-router · plan_work</span>
  route_source        <span class="t-value">workspace-profile</span>
  routing_envelope    <span class="t-value">phased</span>
  current phase       <span class="t-value">contract</span>
  lead                <span class="t-lead">api-designer</span>
  support             <span class="t-value">api-guidelines-skill</span>
  later phases        <span class="t-dim">csharp-developer, qa-test-planner</span>
  activation_status   <span class="t-value">intended-unverified</span></code></pre>
      </figure>
      <p class="wsr-statement">{text.statement}</p>
