---
import AdaptiveRouterDemo from './AdaptiveRouterDemo.astro';
import '../styles/home.css';
type Locale = 'en' | 'zh-tw';

const locale = (Astro.props.locale ?? 'en') as Locale;
const repoUrl = 'https://github.com/eric861129/Workflow-skill-router';
const discussionsUrl = `${repoUrl}/discussions`;
const changelogUrl = `${repoUrl}/blob/main/CHANGELOG.md`;
const skillZipUrl = `${repoUrl}/releases/download/v2.1.1/workflow-skill-router-skill-v2.1.1.zip`;
const rootPath = locale === 'zh-tw' ? '/Workflow-skill-router/zh-tw' : '/Workflow-skill-router';
const assetPath = '/Workflow-skill-router/assets';
const isZh = locale === 'zh-tw';
const alternateLocalePath = isZh ? '/Workflow-skill-router/' : '/Workflow-skill-router/zh-tw/';
const alternateLocaleLabel = isZh ? 'EN' : '繁中';
const localeSwitchLabel = isZh ? 'EN：切換到英文版' : '繁中: Switch to Traditional Chinese';
const themeToggleLabel = isZh ? '切換深淺模式' : 'Toggle color theme';
const themeLabels = isZh
  ? { light: '淺色', dark: '深色' }
  : { light: 'Light', dark: 'Dark' };

const text = {
  "en": {
    "navLabel": "Home navigation",
    "nav": [["How it works", "#how-it-works"], ["Routes", "#routes"], ["Install", "#install"], ["Evidence", "#evidence"]],
    "statement": "One lead Skill per phase, for Claude Code and Codex.",
    "libraryTitle": "Your Skill library in the contract phase",
    "library": [
      ["api-designer", "leads now", "lead"],
      ["api-guidelines-skill", "supports now", "support"],
      ["csharp-developer", "next phase", "next"],
      ["qa-test-planner", "later", "idle"],
      ["playwright", "later", "idle"],
      ["systematic-debugging", "not needed", "idle"]
    ],
    "facts": ["Routes each phase on its own", "Keeps the Skill you name in charge", "Asks before adding support", "One Profile for both hosts", "Local state, no telemetry"],
    "terminalLabel": "A route as plan_work returns it",
    "terminalRequest": "Deliver the api contract, implementation, and tests.",
    "rail": ["Claude Code and Codex", "v2.1.1 published"],
    "railRepo": "MIT licence on GitHub",
    "railSkill": "Instructions only? Use Skill only",
    "action": "Install the Plugin",
    "slogan": ["One lead", "per phase"],
    "figure": "1+3",
    "figureNote": "One lead Skill and up to three support Skills in each phase.",
    "videoLabel": "Recorded run of the Router flight recorder, drawn from core-derived data",
    "introCopy": "As your Skill library grows, every task starts with the same questions: which Skill should lead, when should another one help, and what belongs in the next phase? Claude Code and Codex can answer them on their own, but the answers drift from task to task. Workflow Skill Router writes your answers down. A Profile maps kinds of work to a lead Skill, up to three support Skills, and an exit gate for each phase. The Router reads the request, applies the Profile, checks which Skills this environment can really use, and shows the route before your agent continues. Your agent and your Skills still do the work.",
    "howTitle": "How a route forms",
    "howClauses": ["First it reads the request.", "Then it picks the shape of the work.", "Then one Skill leads the phase.", "At each gate, it routes again."],
    "howCard": [
      ["domain", "api", 1],
      ["profile", "workspace · api-delivery", 2],
      ["envelope", "phased, 3 phases", 2],
      ["lead", "api-designer", 3],
      ["support", "api-guidelines-skill", 3],
      ["activation", "intended-unverified", 3],
      ["gate", "contract-reviewed passed", 4],
      ["next lead", "csharp-developer", 4]
    ],
    "featuresTitle": "What stays in your hands",
    "features": {
      "consent": ["Scoped consent", "Support outside the Skill you named waits for your answer. A rejected Skill never becomes active.", "Approve", "Reject"],
