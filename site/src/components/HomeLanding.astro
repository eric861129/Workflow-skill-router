        "rows": [
          ["Download", "workflow-skill-router-skill-v2.1.1.zip", "download", "From the v2.1.1 GitHub Release."],
          ["Extract", "The inner workflow-skill-router/ folder", "text", "Into your Codex Skills directory."],
          ["Limits", "Instructions only", "text", "No durable state, no consent records, no MCP tools."]
        ]
      }
    ],
    "proofTitle": "What we measured",
    "proofStats": [["6", "routing cases"], ["1", "run per case and arm"], ["26–28%", "more input tokens in this setup"]],
    "proofExtra": [["3/6 → 6/6", "final route fields, Sol retest"], ["0/6 → 3/6", "stricter full contract, Sol retest"], ["v2.1.0", "release gate run with a Claude model"]],
    "validatorTitle": "What the tests show so far",
    "validatorCopy": "On 2026-10-19, we compared routing with and without the Router using GPT-6.1 Sol, GPT-6 Astra, and GPT-6 Luna at medium reasoning. The six-case exploration showed some more consistent workflow decisions. It did not execute development tasks or measure code quality.",
    "validatorEvidenceNote": "After clarifying ambiguous case assumptions and updating the instructions, only Sol was retested. These single-run observations do not establish repeatability, formal model qualification, or full Plugin/host integration. The complete instruction package increased input tokens; lower cost and faster delivery have not been demonstrated.",
    "releaseTitle": "Start with the published release",
    "releaseCopy": "v2.1.1 contains the routing instructions, the local MCP runtime, the Claude Code Plugin, and opt-in Workflow Memory, which is off by default. It is a dependency security patch for v2.1.0 with unchanged routing. The current exploration does not qualify v2.1.1. The release gate was a separate paired run with a Claude model on v2.1.0.",
    "evidenceLink": "Read the evaluation method and limits",
    "faqTitle": "Questions",
    "faq": [
      ["Does it install or run my Skills?", "No. The Router plans which Skill leads and which support each phase needs. Installing Skills, activating them, and granting permissions stay with you and with Claude Code or Codex."],
      ["Which model does it use?", "None of its own. The local runtime classifies work and matches Profiles with deterministic rules, and your agent keeps the model you chose."],
      ["Does it send data anywhere?", "No. Plans, consent records, and Profiles live in a local data directory outside the Plugin cache, and telemetry is off."],
      ["What if Python is missing?", "The MCP server cannot start, so the Skill runs as skill-only-fallback: routing instructions without durable state. It says so instead of claiming the full mode."],
      ["Can Claude Code and Codex share my setup?", "Yes. Both read the same personal Profiles and local state. A repository can keep one .codex/workflow-skill-router.json, or add .claude/workflow-skill-router.json when Claude Code needs a different Skill Tree."],
      ["Is it ready for my team?", "v2.1.1 is published for Claude Code and Codex. The evaluation so far covers routing decisions only, so try it on your own workflow first."]
    ],
    "marquee": "One lead Skill per phase. Your workflow as config. Claude Code and Codex.",
    "finalTitle": "Bring your workflow. Inspect the route.",
    "finalCopy": "Start with the published package, check the available capabilities, and decide whether the routing fits your work. The code and routing rules are open source under the MIT License.",
    "footerNavTitle": "Read on",
    "footerNav": [["Quickstart", "guides/quickstart"], ["Claude Code install", "guides/install-claude-code"], ["Personal Routing Profiles", "concepts/personal-routing-profiles"], ["MCP tools", "reference/mcp-tools"], ["Security boundaries", "reference/security-boundaries"]],
    "status": ["v2.1.1 is the published release.", "Claude Code support starts with v2.1.0."],
    "changelog": "Read the changelog",
    "contactTitle": "Questions and ideas",
    "contact": "GitHub Discussions",
    "legal": "MIT License. Workflow Skill Router contributors.",
    "star": "Star it on GitHub"
  },
  "zh-tw": {
    "navLabel": "首頁導覽",
    "nav": [["運作方式", "#how-it-works"], ["路由紀錄", "#routes"], ["安裝", "#install"], ["實測", "#evidence"]],
