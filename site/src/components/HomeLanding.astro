---
import AdaptiveRouterDemo from './AdaptiveRouterDemo.astro';
type Locale = 'en' | 'zh-tw';

const locale = (Astro.props.locale ?? 'en') as Locale;
const repoUrl = 'https://github.com/eric861129/Workflow-skill-router';
const rootPath = locale === 'zh-tw' ? '/Workflow-skill-router/zh-tw' : '/Workflow-skill-router';
const isZh = locale === 'zh-tw';
const alternateLocalePath = isZh ? '/Workflow-skill-router/' : '/Workflow-skill-router/zh-tw/';
const alternateLocaleLabel = isZh ? 'EN' : '繁中';
const localeSwitchLabel = isZh ? 'EN：切換到英文版' : '繁中: Switch to Traditional Chinese';
const themeToggleLabel = isZh ? '切換深淺模式' : 'Toggle color theme';
const themeLabels = isZh
  ? { light: '淺色', dark: '深色' }
  : { light: 'Light', dark: 'Dark' };

const text = {
  "en": {
    "nav": [
      "Why use it",
      "How it works",
      "Evidence"
    ],
    "navLinks": [
      "#why-it-works",
      "#examples",
      "#validator"
    ],
    "star": "View on GitHub",
    "download": "Get started",
    "showcase": "Inspect recorded routes",
    "introTitle": "Your Skills need a workflow you can reuse",
    "introCopy": "As your Skill library grows, you keep deciding which Skill should lead, when another should help, and what belongs in the next phase. Codex can make these choices. The Router lets you make your preferred process explicit, inspect it, and reuse it across tasks.",
    "introLink": "Define your own routing profile",
    "processLabel": "Why the Router is designed this way",
    "processSteps": [
      [
        "Focus",
        "Give each phase one primary Skill",
        "Select only the support needed now. Keep implementation and deployment out of a phase that is still about planning."
      ],
      [
        "Your workflow",
        "Make repeated choices reusable",
        "Personal and workspace profiles map tasks to the Skills and completion checks you prefer."
      ],
      [
        "Your choices",
        "Respect the Skill you name",
        "Keep an explicitly named Skill in charge. Adding support outside that choice requires your consent."
      ],
      [
        "Available capabilities",
        "Distinguish a plan from execution",
        "Show missing capabilities and runtime limits. A planned Skill is not proof that it was activated."
      ]
    ],
    "processNoteTitle": "A useful fit when process matters",
    "processNote": "Use it for overlapping Skills, repeated team workflows, or work that crosses phases and projects. For a small task with a clear Skill choice, extra configuration may add little value.",
    "contractLink": "Read the routing rules",
    "templateLink": "Explore the three work modes",
    "examplesTitle": "Start small. Add structure when the work needs it.",
    "examplesCopy": "The Router reads the task, applies your workflow preferences, and reports the plan and its limits. Codex and the selected Skills still do the work.",
    "templateCode": "Your request + workflow preferences\n→ Current phase and intended Skills\n→ Available capabilities, limits, and next step",
    "templateHighlights": [
      [
        "Single",
        "One bounded task, such as diagnosing a bug, with only the Skills needed for that task."
      ],
      [
        "Phased",
        "Plan, implement, and verify separately. Reconsider the Skill selection at each phase."
      ],
      [
        "Managed Goal",
        "Keep a local work graph for dependencies and resuming work. Native Codex Goal integration still needs host support."
      ]
    ],
    "outcomesTitle": "Choose the level you need",
    "outcomes": [
      [
        "Standalone Skill",
        "Routing instructions for Codex. No local MCP state machine or persistent consent records."
      ],
      [
        "Plugin + MCP",
        "Routing instructions plus local plans, state, and consent records. Requires Node.js 24+ and Python 3.11+."
      ],
      [
        "Host integration",
        "Native Goal scheduling and verified execution depend on additional host capabilities. Installing the Plugin alone does not provide them."
      ],
      [
        "Your specialist Skills",
        "Install the Skills your workflow references separately. The Router does not bundle every specialist or switch your model."
      ]
    ],
    "validatorTitle": "What the tests show so far",
    "validatorCopy": "On 2026-10-19, we compared routing with and without the Router using GPT-6.1 Sol, GPT-6 Astra, and GPT-6 Luna at medium reasoning. The six-case exploration showed some more consistent workflow decisions. It did not execute development tasks or measure code quality.",
    "validatorEvidenceNote": "After clarifying ambiguous case assumptions and updating the instructions, only Sol was retested. These single-run observations do not establish repeatability, formal model qualification, or full Plugin/host integration. The complete instruction package increased input tokens; lower cost and faster delivery have not been demonstrated.",
    "proofStats": [
      [
        "6",
        "routing cases"
      ],
      [
        "1",
        "run per case and arm"
      ],
      [
        "26–28%",
        "more input tokens in this setup"
      ]
    ],
    "validatorCommand": "# Published release: v2.0.2\ncodex plugin marketplace add eric861129/Workflow-skill-router --ref v2.0.2\ncodex plugin add workflow-skill-router@workflow-skill-router\ncodex plugin list",
    "releaseTitle": "Start with the published release",
    "releaseCopy": "v2.0.2 contains the routing instructions and local MCP runtime. Development main includes additional work, such as opt-in Workflow Memory, that is not in this release. The current exploration does not qualify v2.0.2.",
    "evidenceLink": "Read the evaluation method and limits",
    "finalTitle": "Bring your workflow. Inspect the route.",
    "finalCopy": "Start with the published package, check the available capabilities, and decide whether the routing fits your work. The code and routing rules are open source under the MIT License."
  },
  "zh-tw": {
    "nav": [
      "為何使用",
      "如何運作",
      "實測證據"
    ],
    "navLinks": [
      "#why-it-works",
      "#examples",
      "#validator"
    ],
    "star": "查看 GitHub",
    "download": "開始使用",
    "showcase": "查看既有路由紀錄",
    "introTitle": "讓常用的 Skills 有一套可重用的工作流程",
    "introCopy": "Skills 越裝越多，你也需要反覆決定由誰主導、何時需要支援，以及哪些工作留到下一階段。Codex 可以自行判斷；Router 讓你把偏好的流程明確定義、檢查後，在不同任務中重複使用。",
    "introLink": "設定自己的路由規則",
    "processLabel": "為什麼這樣設計",
    "processSteps": [
      [
        "聚焦當下",
        "每個階段由一個主要 Skill 負責",
        "只選擇目前需要的支援。還在規劃時，就先聚焦規劃，將實作與部署留到對應階段。"
      ],
      [
        "你的流程",
        "讓重複的選擇變成可重用設定",
        "個人與工作區設定將任務對應到你偏好的 Skills 與完成條件。"
      ],
      [
        "你的選擇",
        "尊重你明確指定的 Skill",
        "指定的 Skill 維持主導地位。加入指定範圍外的支援前，需要取得你的同意。"
      ],
      [
        "可用能力",
        "分清楚計畫與實際執行",
        "顯示缺少的能力與執行環境限制。計畫選用某個 Skill，不代表它已經啟用。"
      ]
    ],
    "processNoteTitle": "適合需要固定流程的工作",
    "processNote": "當 Skills 職責重疊、團隊反覆使用相同流程，或工作跨越階段與專案時，可以考慮使用。若只是小任務，也已知道要用哪個 Skill，額外設定可能沒有太多幫助。",
    "contractLink": "閱讀路由規則",
    "templateLink": "了解三種工作模式",
    "examplesTitle": "從小任務開始，依工作需要加入流程",
    "examplesCopy": "Router 讀取任務、套用你的流程偏好，並回報計畫與限制。實際工作仍由 Codex 與選定的 Skills 執行。",
    "templateCode": "你的需求與流程偏好\n→ 目前階段與預計使用的 Skills\n→ 可用能力、限制與下一步",
    "templateHighlights": [
      [
        "單一任務 Single",
        "處理一件範圍明確的工作，例如釐清錯誤原因，只選擇這件事需要的 Skills。"
      ],
      [
        "多階段 Phased",
        "分開規劃、實作與驗證，在每個階段重新判斷需要哪些 Skills。"
      ],
      [
        "工作圖 Managed Goal",
        "在本機保留相依關係與續作進度。整合 Codex 原生 Goal 仍需要執行環境支援。"
      ]
    ],
    "outcomesTitle": "選擇需要的使用方式",
    "outcomes": [
      [
        "獨立 Skill",
        "提供 Codex 路由指引，沒有本機 MCP 狀態機，也不會持久保存同意紀錄。"
      ],
      [
        "Plugin + MCP",
        "除了路由指引，也在本機保存計畫、狀態與同意紀錄。需要 Node.js 24+ 與 Python 3.11+。"
      ],
      [
        "執行環境整合",
        "原生 Goal 排程與經驗證的執行需要額外能力，安裝 Plugin 本身不會提供這些整合。"
      ],
      [
        "你使用的專業 Skills",
        "工作流程引用的 Skills 需要另外安裝。Router 不會附帶所有專業 Skills，也不會替你切換模型。"
      ]
    ],
    "validatorTitle": "目前實測能說明什麼",
    "validatorCopy": "2026-10-19 使用 GPT-6.1 Sol、GPT-6 Astra、GPT-6 Luna，在 medium 推理設定下比較有無 Router 的路由決策。六個案例的探索性測試觀察到部分流程決策更一致，但沒有執行開發任務或量測程式品質。",
    "validatorEvidenceNote": "釐清案例前提的歧義並更新指引後，僅對 Sol 重新測試。這些單次觀測尚未證明穩定性、正式模型資格或完整 Plugin／執行環境整合。完整載入指令套件會增加輸入 Token；尚未證明能降低成本或加快交付。",
    "proofStats": [
      [
        "6",
        "個路由案例"
      ],
      [
        "1",
        "次執行，每組每個案例"
      ],
      [
        "26–28%",
        "本次測試增加的輸入 Token"
      ]
    ],
    "validatorCommand": "# 已發布版本：v2.0.2\ncodex plugin marketplace add eric861129/Workflow-skill-router --ref v2.0.2\ncodex plugin add workflow-skill-router@workflow-skill-router\ncodex plugin list",
    "releaseTitle": "從已發布的版本開始",
    "releaseCopy": "v2.0.2 包含路由指引與本機 MCP 執行程式。開發中主分支另有尚未納入此版本的內容，例如需自行啟用的 Workflow Memory。目前的探索性測試不能作為 v2.0.2 的資格證明。",
    "evidenceLink": "閱讀評測方法與限制",
    "finalTitle": "帶入你的流程，檢查每次路由",
    "finalCopy": "從發布套件開始，確認可用能力，再判斷路由是否符合你的工作方式。程式碼與路由規則以 MIT 授權開放使用。"
  }
}[locale];

const heroText = {
  "en": {
    "eyebrow": "Open-source workflow routing for Codex",
    "title": "Make your Codex workflow repeatable.",
    "body": "Choose Skills for the task at hand, keep each phase focused, and respect the workflow you define. Use routing instructions on their own, or add the Plugin for local plans and consent records.",
    "primary": "Install Plugin + MCP",
    "secondary": "Use Skill only",
    "tertiary": "Why use a Router?",
    "explainerLabel": "Illustrative workflow",
    "explainerTitle": "One phase at a time."
  },
  "zh-tw": {
    "eyebrow": "開放原始碼的 Codex 工作流程路由工具",
    "title": "讓 Codex 按照你的工作流程做事",
    "body": "為目前任務選擇 Skills、聚焦當下階段，並遵循你設定的工作流程。可以單獨使用路由指引，或安裝 Plugin，在本機保存計畫與同意紀錄。",
    "primary": "安裝 Plugin + MCP",
    "secondary": "只使用 Skill",
    "tertiary": "為什麼需要 Router？",
    "explainerLabel": "流程示意",
    "explainerTitle": "每次聚焦一個階段"
  }
}[locale];

const heroPreview = {
  "en": {
    "requestLabel": "Example request",
    "request": "Plan an API change with my planning Skill. Implement later.",
    "routeLabel": "Example plan · activation unverified",
    "route": [
      [
        "Now",
        "Named planning Skill."
      ],
      [
        "Later",
        "Build → verify."
      ],
      [
        "Boundary",
        "Extra support needs consent. Check availability."
      ]
    ]
  },
  "zh-tw": {
    "requestLabel": "需求範例",
    "request": "使用我指定的規劃 Skill，先規劃 API 變更，之後再實作。",
    "routeLabel": "流程示意，尚未驗證啟用",
    "route": [
      [
        "現在",
        "指定的規劃 Skill。"
      ],
      [
        "之後",
        "實作 → 驗證。"
      ],
      [
        "邊界",
        "額外支援需同意，能力須確認可用。"
      ]
    ]
  }
}[locale];
import memoryFlightRecorder from '../data/memory-flight-recorder.generated.json';
const m4bIsZh = Astro.currentLocale?.toLowerCase() === 'zh-tw';
---

<main class="wsr-landing" data-wsr-home data-locale={locale}>
  <nav class="wsr-floating-nav" aria-label={isZh ? '首頁導覽' : 'Home navigation'}>
    <a class="wsr-wordmark" href={rootPath + '/'}>
      <span class="wsr-wordmark-mark" aria-hidden="true"></span>
      <span>Workflow Skill Router</span>
    </a>
    <div class="wsr-nav-links">
      {text.nav.map((item, index) => (
        <a href={text.navLinks[index]}>{item}</a>
      ))}
    </div>
    <div class="wsr-nav-actions">
      <a class="wsr-locale-switch" href={alternateLocalePath} aria-label={localeSwitchLabel}>
        {alternateLocaleLabel}
      </a>
      <button
        class="wsr-theme-toggle"
        type="button"
        data-wsr-theme-toggle
        data-light-label={themeLabels.light}
        data-dark-label={themeLabels.dark}
        aria-label={themeToggleLabel}
      >
        <span class="wsr-theme-dot" aria-hidden="true"></span>
        <span data-wsr-theme-label>{themeLabels.dark}</span>
      </button>
      <a class="wsr-nav-star" href={repoUrl} target="_blank" rel="noreferrer" aria-label={text.star} data-analytics-event="site_nav_github">
        <span class="wsr-star-full">{text.star}</span>
        <span class="wsr-star-short">GitHub</span>
      </a>
    </div>
  </nav>

  <section class="wsr-hero" aria-labelledby="_top">
    <div class="wsr-shell wsr-hero-inner">
      <div class="wsr-hero-copy-block">
        <span class="wsr-hero-eyebrow">{heroText.eyebrow}</span>
        <h1 id="_top" class="wsr-hero-title">{heroText.title}</h1>
        <p class="wsr-hero-copy">{heroText.body}</p>
        <div class="wsr-hero-actions">
          <a class="wsr-button wsr-button-primary" href={`${rootPath}/guides/install-plugin/`} data-analytics-event="site_hero_install_plugin">{heroText.primary}</a>
          <a class="wsr-button wsr-button-secondary" href={`${rootPath}/guides/install-skill/`}>{heroText.secondary}</a>
          <a class="wsr-hero-tertiary" href="#why-it-works">{heroText.tertiary}</a>
        </div>
      </div>

      <div id="route-demo" class="wsr-hero-explainer wsr-hero-preview" aria-label={heroText.explainerLabel}>
        <div class="wsr-hero-explainer-header">
          <span>{heroText.explainerLabel}</span>
          <h2>{heroText.explainerTitle}</h2>
        </div>
        <div class="wsr-hero-preview-flow">
          <div class="wsr-hero-request">
            <span>{heroPreview.requestLabel}</span>
            <p>{heroPreview.request}</p>
          </div>
          <div class="wsr-hero-flow-rail" aria-hidden="true">
            <span></span>
          </div>
          <div class="wsr-hero-route-card">
            <span>{heroPreview.routeLabel}</span>
            <div class="wsr-hero-route-list">
              {heroPreview.route.map(([label, value]) => (
                <div>
                  <span>{label}</span>
                  <p>{value}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  <section id="why-it-works" class="wsr-section wsr-section-light">
    <div class="wsr-shell wsr-section-grid">
      <div>
        <h2>{text.introTitle}</h2>
        <p>{text.introCopy}</p>
        <a class="wsr-text-link" href={`${rootPath}/concepts/personal-routing-profiles/`}>{text.introLink}</a>
      </div>
      <div class="wsr-process-panel" aria-label={text.processLabel}>
        <span class="wsr-process-kicker">{text.processLabel}</span>
        <div class="wsr-process-list">
          {text.processSteps.map(([label, title, body], index) => (
            <article class="wsr-process-step">
              <span class="wsr-process-number">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <span class="wsr-process-label">{label}</span>
                <h3>{title}</h3>
                <p>{body}</p>
              </div>
            </article>
          ))}
        </div>
        <div class="wsr-process-note">
          <h3>{text.processNoteTitle}</h3>
          <p>{text.processNote}</p>
          <div class="wsr-process-links">
            <a class="wsr-text-link" href={`${rootPath}/reference/routing-contract/`}>{text.contractLink}</a>
            <a class="wsr-text-link" href={`${rootPath}/concepts/personal-routing-profiles/`}>{isZh ? '自訂 Skill Tree' : 'Own your Skill Tree'}</a>
            <a class="wsr-text-link" href={`${rootPath}/showcase/`}>{text.showcase}</a>
            <a class="wsr-text-link" href={`${rootPath}/concepts/routing-envelopes/`}>{text.templateLink}</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="examples" class="wsr-section wsr-section-dark wsr-proof" data-wsr-pin>
    <div class="wsr-shell wsr-proof-grid">
      <div class="wsr-proof-pin">
        <h2>{text.examplesTitle}</h2>
        <p>{text.examplesCopy}</p>
        <a class="wsr-button wsr-button-secondary-dark" href={`${rootPath}/concepts/routing-envelopes/`}>{text.templateLink}</a>
      </div>
      <div class="wsr-proof-stack">
        <div class="wsr-template-showcase wsr-motion-image">
          <div>
            <span class="wsr-template-kicker">Single / Phased / Managed Goal</span>
            <h3>{isZh ? '配合任務的範圍安排流程' : 'Match the structure to the task'}</h3>
            <p>{isZh ? '本機執行程式使用固定規則分類工作與比對設定。計畫、相依關係與完成條件都可以檢查；實際執行仍受使用者授權與環境能力限制。' : 'The local runtime uses deterministic rules to classify work and match profiles. Plans, dependencies, and completion checks stay inspectable; execution still depends on user authorization and available capabilities.'}</p>
          </div>
          <pre><code>{text.templateCode}</code></pre>
          <div class="wsr-template-grid">
            {text.templateHighlights.map(([title, body]) => (
              <a class="wsr-template-pill" href={`${rootPath}/concepts/routing-envelopes/`}>
                <span>{title}</span>
                <p>{body}</p>
              </a>
            ))}
          </div>
          <div class="wsr-template-actions">
            <a class="wsr-text-link" href={`${rootPath}/guides/install-plugin/`}>{isZh ? '安裝 Plugin + MCP' : 'Install Plugin + MCP'}</a>
            <a class="wsr-text-link" href={`${rootPath}/guides/install-skill/`}>{isZh ? '安裝純 SKILL' : 'Install Skill-only'}</a>
          </div>
        </div>
        <div class="wsr-outcome-carousel" data-wsr-carousel>
          <div class="wsr-carousel-controls">
            <button type="button" data-wsr-prev aria-label={isZh ? '上一個成果' : 'Previous outcome'}>
              <span aria-hidden="true">←</span>
              <span>{isZh ? '上一則' : 'Previous'}</span>
            </button>
            <h3>{text.outcomesTitle}</h3>
            <button type="button" data-wsr-next aria-label={isZh ? '下一個成果' : 'Next outcome'}>
              <span>{isZh ? '下一則' : 'Next'}</span>
              <span aria-hidden="true">→</span>
            </button>
          </div>
          <div class="wsr-carousel-track" data-wsr-track>
            {text.outcomes.map(([title, body]) => (
              <article class="wsr-outcome-card wsr-motion-image">
                <h4>{title}</h4>
                <p>{body}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="validator" class="wsr-section wsr-section-light">
    <div class="wsr-shell wsr-validator">
      <div>
        <h2>{text.validatorTitle}</h2>
        <p>{text.validatorCopy}</p>
        <p>{text.validatorEvidenceNote}</p>
        <div class="wsr-proof-stats" aria-label={isZh ? '探索性測試範圍與成本' : 'Exploratory test scope and cost'}>
          {text.proofStats.map(([value, label]) => (
            <span>
              <strong>{value}</strong>
              {label}
            </span>
          ))}
        </div>
      </div>
      <div class="wsr-command-card">
        <h3>{text.releaseTitle}</h3>
        <p>{text.releaseCopy}</p>
        <pre><code>{text.validatorCommand}</code></pre>
        <a class="wsr-text-link" href={`${rootPath}/reference/model-evaluation/`}>{text.evidenceLink}</a>
      </div>
    </div>
  </section>

  <AdaptiveRouterDemo locale={isZh ? 'zh-TW' : 'en'} initialPreset="personal-skill-tree" />

  <section class="wsr-final-cta">
    <div class="wsr-shell">
      <h2>{text.finalTitle}</h2>
      <p>{text.finalCopy}</p>
      <div class="wsr-hero-actions">
        <a class="wsr-button wsr-button-primary" href={repoUrl} target="_blank" rel="noreferrer">{text.star}</a>
        <a class="wsr-button wsr-button-secondary" href={`${rootPath}/guides/quickstart/`}>{text.download}</a>
      </div>
    </div>
  </section>
<!-- M4-B memory-flight-recorder:start -->
<section class="memory-flight-recorder" data-memory-flight-recorder aria-labelledby="memory-flight-recorder-title">
  <div class="memory-flight-recorder__intro">
    <h2 id="memory-flight-recorder-title">
      {m4bIsZh ? 'Memory Flight Recorder' : 'Memory Flight Recorder'}
    </h2>
    <p>
      {m4bIsZh
        ? '開發中功能，尚未包含在 v2.0.2。以下既有紀錄呈現五種去識別情境中的政策、提案、設定更新與清除事件；Workflow Memory 預設關閉。'
        : 'Development feature, not included in v2.0.2. These existing records cover five sanitized scenarios for policy, proposals, profile updates, and purge events. Workflow Memory is off by default.'}
    </p>
    <p class="memory-flight-recorder__boundary">
      <strong>deterministic-local-pilot</strong>
      <span>{m4bIsZh ? '不是 Model Evidence' : 'not Model Evidence'}</span>
    </p>
  </div>

  <div class="memory-flight-recorder__workspace">
    <div class="memory-flight-recorder__tabs" role="tablist" aria-label="Memory scenarios">
      {memoryFlightRecorder.scenarios.map((scenario, index) => (
        <button
          type="button"
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-controls={`memory-panel-${scenario.id}`}
          id={`memory-tab-${scenario.id}`}
          data-memory-tab={scenario.id}
        >
          {m4bIsZh ? scenario.title_zh_tw : scenario.title}
        </button>
      ))}
    </div>

    <div class="memory-flight-recorder__panels">
      {memoryFlightRecorder.scenarios.map((scenario, index) => (
        <article
          id={`memory-panel-${scenario.id}`}
          role="tabpanel"
          aria-labelledby={`memory-tab-${scenario.id}`}
          data-memory-panel={scenario.id}
          hidden={index !== 0}
        >
          <div class="memory-flight-recorder__panel-heading">
            <h3>{m4bIsZh ? scenario.title_zh_tw : scenario.title}</h3>
            <code>{scenario.evidence_class}</code>
          </div>
          <p>{m4bIsZh ? scenario.summary_zh_tw : scenario.summary}</p>
          <ol>
            {scenario.events.map((event) => (
              <li>
                <span>{String(event.seq).padStart(2, '0')}</span>
                <div>
                  <strong>{event.event}</strong>
                  <small>{event.state} · {event.reason}</small>
                </div>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </div>

  <dl class="memory-flight-recorder__pilot" aria-label="Deterministic local Pilot distribution">
    <div><dt>{m4bIsZh ? '總筆數' : 'Records'}</dt><dd>{memoryFlightRecorder.pilot.summary.total}</dd></div>
    <div><dt>Single</dt><dd>{memoryFlightRecorder.pilot.summary.single}</dd></div>
    <div><dt>Phased</dt><dd>{memoryFlightRecorder.pilot.summary.phased}</dd></div>
    <div><dt>Goal-like</dt><dd>{memoryFlightRecorder.pilot.summary.goal_like}</dd></div>
    <div><dt>{m4bIsZh ? '使用 Profile' : 'Profile-assisted'}</dt><dd>{memoryFlightRecorder.pilot.summary.profile_used}</dd></div>
  </dl>
</section>

<script>
  document.querySelectorAll('[data-memory-flight-recorder]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll('[data-memory-tab]'));
    const panels = Array.from(root.querySelectorAll('[data-memory-panel]'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const selected = tab.getAttribute('data-memory-tab');
        tabs.forEach((item) => item.setAttribute('aria-selected', item === tab ? 'true' : 'false'));
        panels.forEach((panel) => {
          panel.hidden = panel.getAttribute('data-memory-panel') !== selected;
        });
      });
    });
  });
</script>

